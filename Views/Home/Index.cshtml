@{
    ViewData["Title"] = "Home";
}

<div class="p-4 mb-4 bg-light rounded-3">
    <h1 class="display-6">Board Game Rental System</h1>
    <p class="lead">Browse games, rent your favorites, and leave reviews.</p>
    <a class="btn btn-primary" asp-controller="Games" asp-action="Index">Browse Games</a>
</div>

<div class="row">
    <div class="col-md-4">
        <h4>Catalog</h4>
        <p>View all games with genre and players filters.</p>
    </div>
    <div class="col-md-4">
        <h4>Rentals</h4>
        <p>Rent a game and check your rental history anytime.</p>
    </div>
    <div class="col-md-4">
        <h4>Reviews</h4>
        <p>Give rating from 1 to 5 and write a short comment.</p>
    </div>
</div>
