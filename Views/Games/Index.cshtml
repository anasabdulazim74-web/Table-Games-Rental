@model IEnumerable<GameRentalSystem.Models.Game>

@{
    ViewData["Title"] = "Games";
    var genres = ViewBag.Genres as List<string> ?? new List<string>();
}

<h2>Game Catalog</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select class="form-select" name="genre">
            <option value="">All Genres</option>
            @foreach (var genre in genres)
            {
                <option value="@genre">@genre</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <input type="number" name="players" class="form-control" min="1" placeholder="Number of players" />
    </div>
    <div class="col-md-3">
        <input type="number" name="playTime" class="form-control" min="10" placeholder="Max Play Time (min)" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a class="btn btn-secondary" asp-action="Index">Reset</a>
    </div>
</form>

<div class="row">
    @foreach (var game in Model)
    {
        var average = game.Reviews.Count == 0 ? 0 : game.Reviews.Average(r => r.Rating);
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img class="card-img-top" src="@(string.IsNullOrWhiteSpace(game.ImageUrl) ? "https://via.placeholder.com/400x220?text=Board+Game" : game.ImageUrl)" alt="@game.Name" />
                <div class="card-body">
                    <h5 class="card-title">@game.Name</h5>
                    <p class="mb-1"><strong>Genre:</strong> @game.Genre</p>
                    <p class="mb-1"><strong>Players:</strong> @game.NumberOfPlayers</p>
                    <p class="mb-1"><strong>Play Time:</strong> @game.PlayTime min</p>
                    <p class="mb-1"><strong>Average Rating:</strong> @(average.ToString("0.0")) / 5</p>
                    <p>@game.Description</p>
                </div>
                <div class="card-footer">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@game.Id">Details</a>
                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@game.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@game.Id">Delete</a>
                    }
                </div>
            </div>
        </div>
    }
</div>
